&CONTROL
  calculation = 'scf',
  prefix = 'aluminum',
  outdir = './tmp',
  pseudo_dir = './pseudo',
/
&SYSTEM
  ibrav = 2,
  celldm(1) = 7.63,
  nat = 1,
  ntyp = 1,
  ecutwfc = 30.0,
  ecutrho = 240.0,
  occupations = 'smearing',
  smearing = 'mp',
  degauss = 0.02,
/
&ELECTRONS
  conv_thr = 1.0d-8,
/
ATOMIC_SPECIES
  Al  26.982  Al.pbe-n-kjpaw_psl.1.0.0.UPF

ATOMIC_POSITIONS crystal
  Al  0.00  0.00  0.00

K_POINTS automatic
  8 8 8 0 0 0
